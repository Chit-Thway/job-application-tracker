<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\JobTracker.Web\JobTracker.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\PastedJobs\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\Html\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\Extension\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\browser-extension\**\*"
          Link="BrowserExtension\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
