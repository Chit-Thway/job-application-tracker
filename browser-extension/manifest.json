{
  "manifest_version": 3,
  "name": "Job Application Tracker",
  "version": "1.2.0",
  "minimum_chrome_version": "116",
  "description": "Extract a job ad for review or fill an application using your saved applicant profile.",
  "homepage_url": "https://myjobtracker.com.au/extension",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://myjobtracker.com.au/*"
  ],
  "background": {
    "service_worker": "autofill-connection.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Extract or fill",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
