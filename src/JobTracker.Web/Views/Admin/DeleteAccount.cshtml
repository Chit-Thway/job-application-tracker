@model AdminDeleteAccountViewModel
@{
    ViewData["Title"] = "Delete account";
}

<section class="form-page danger-page">
    <div class="shell confirmation-shell">
        <a class="back-link" asp-controller="Admin" asp-action="Users">← Account administration</a>
        <div class="confirmation-card">
            <span class="danger-symbol" aria-hidden="true">!</span>
            <p class="eyebrow">Permanent account deletion</p>
            <h1>Delete @Model.DisplayName?</h1>
            <p>This permanently removes the account and all of its private applications, companies, history, contacts, tasks, appointments, notes, and settings. This cannot be undone.</p>
            <dl class="confirmation-summary">
                <div><dt>Email</dt><dd>@Model.Email</dd></div>
                <div><dt>Applications</dt><dd>@Model.ApplicationCount</dd></div>
            </dl>
            <form method="post" asp-controller="Admin" asp-action="DeleteAccount" asp-route-userId="@Model.UserId" class="account-form">
                <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
                <div class="field">
                    <label asp-for="ConfirmationEmail"></label>
                    <input asp-for="ConfirmationEmail" autocomplete="off" spellcheck="false" />
                    <small class="field-help">Enter <strong>@Model.Email</strong> exactly.</small>
                    <span asp-validation-for="ConfirmationEmail" class="field-error"></span>
                </div>
                <div class="editor-actions">
                    <button class="button button-danger" type="submit">Delete account permanently</button>
                    <a class="button button-secondary" asp-controller="Admin" asp-action="Users">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</section>
