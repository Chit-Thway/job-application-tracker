@model ApplicationFormViewModel

<div asp-validation-summary="All" class="validation-summary" role="alert" tabindex="-1" autofocus></div>

<div class="form-grid">
    <div class="field form-span-2">
        <label asp-for="RoleTitle"></label>
        <input asp-for="RoleTitle" autocomplete="organization-title" />
        <span asp-validation-for="RoleTitle" class="field-error"></span>
    </div>

    <div class="field">
        <label asp-for="CompanyId"></label>
        <select asp-for="CompanyId">
            <option value="">No company selected</option>
            @foreach (var company in Model.Companies)
            {
                <option value="@company.Id">@company.Name@(string.IsNullOrWhiteSpace(company.Location) ? string.Empty : $" — {company.Location}")</option>
            }
        </select>
        <span asp-validation-for="CompanyId" class="field-error"></span>
        <a class="field-help text-link" asp-controller="Companies" asp-action="Create">Add a new company</a>
    </div>

    <div class="field">
        <label asp-for="AppliedOn"></label>
        <input asp-for="AppliedOn" type="date" />
        <span asp-validation-for="AppliedOn" class="field-error"></span>
    </div>

    <div class="field form-span-2">
        <label asp-for="SourceUrl"></label>
        <input asp-for="SourceUrl" type="url" inputmode="url" placeholder="https://…" />
        <span asp-validation-for="SourceUrl" class="field-error"></span>
    </div>

    <div class="field form-span-2">
        <label asp-for="Notes"></label>
        <textarea asp-for="Notes" rows="7" placeholder="Anything useful about the role, application, or next step."></textarea>
        <span asp-validation-for="Notes" class="field-error"></span>
    </div>
</div>

<label class="save-choice">
    <input asp-for="IsSavedForever" />
    <span>
        <strong>Saved</strong>
        <small>Saved applications are exempt from automatic retention deletion. New applications are not saved by default.</small>
    </span>
</label>
