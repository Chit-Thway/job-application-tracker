@model ApplicationFormViewModel
@{
    ViewData["Title"] = "Add application";
}

<section class="form-page">
    <div class="shell narrow-shell">
        <a class="back-link" asp-action="Index">← Applications</a>
        <div class="form-heading">
            <p class="eyebrow">Manual entry</p>
            <h1>Add an application.</h1>
            <p>Start with the facts you know. You can edit everything later.</p>
        </div>
        <aside class="import-callout">
            <div>
                <p class="mini-label">Faster option</p>
                <h2>Already have the job advertisement?</h2>
                <p>Import a public link or paste the text, then review every detected detail before anything is saved.</p>
            </div>
            <div class="import-actions">
                <a class="button button-primary" asp-controller="ApplicationImports" asp-action="ImportUrl">Import public link</a>
                <a class="button button-secondary" asp-controller="ApplicationImports" asp-action="PasteText">Paste job text</a>
            </div>
        </aside>
        <form method="post" class="editor-card">
            <partial name="_Form" model="Model" />
            <div class="editor-actions">
                <button class="button button-primary" type="submit">Add application</button>
                <a class="button button-secondary" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</section>
