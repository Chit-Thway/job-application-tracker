@model CompanyFormViewModel
@{
    ViewData["Title"] = "Edit company";
}

<section class="form-page">
    <div class="shell narrow-shell">
        <a class="back-link" asp-action="Details" asp-route-id="@Model.Id">← Company details</a>
        <div class="form-heading">
            <p class="eyebrow">Company directory</p>
            <h1>Edit @Model.Name.</h1>
            <p>Updates appear everywhere this company is connected.</p>
        </div>
        <form method="post" class="editor-card">
            <partial name="_Form" model="Model" />
            <div class="editor-actions">
                <button class="button button-primary" type="submit">Save changes</button>
                <a class="button button-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
            </div>
        </form>
    </div>
</section>
