@model JobTracker.Web.Autofill.EducationEntry
<fieldset class="autofill-entry" data-entry>
    <legend>Qualification <span data-entry-number></span></legend>
    <div class="autofill-fields">
        <div class="field"><label asp-for="Institution">Institution</label><input asp-for="Institution" /></div>
        <div class="field"><label asp-for="Qualification">Qualification</label><input asp-for="Qualification" /></div>
        <div class="field autofill-full"><label asp-for="FieldOfStudy">Field of study</label><input asp-for="FieldOfStudy" /></div>
        <div class="field"><label asp-for="StartMonth">Start month</label><input asp-for="StartMonth" type="month" /></div>
        <div class="field"><label asp-for="EndMonth">End month</label><input asp-for="EndMonth" type="month" /></div>
    </div>
    <div class="autofill-actions autofill-entry-actions">
        <button type="button" class="autofill-remove" data-remove-entry>Remove education</button>
    </div>
</fieldset>
