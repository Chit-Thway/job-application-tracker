@model JobTracker.Web.Autofill.ExperienceEntry
<fieldset class="autofill-entry" data-entry>
    <legend>Role</legend>
    <div class="autofill-fields">
        <div class="field"><label asp-for="Employer">Employer</label><input asp-for="Employer" /></div>
        <div class="field"><label asp-for="Title">Job title</label><input asp-for="Title" /></div>
        <div class="field"><label asp-for="Location">Location</label><input asp-for="Location" /></div>
        <div class="field"><label asp-for="StartMonth">Start month</label><input asp-for="StartMonth" type="month" /></div>
        <div class="field" data-end-month hidden="@Model.Current"><label asp-for="EndMonth">End month</label><input asp-for="EndMonth" type="month" /></div>
        <div class="field">
            <label><input type="checkbox" name="@Html.NameFor(role => role.Current)" value="true" checked="@Model.Current" data-current-role /> I currently work here</label>
        </div>
        <div class="field autofill-wide"><label asp-for="Responsibilities">Responsibilities</label><textarea asp-for="Responsibilities" rows="3"></textarea></div>
    </div>
    <div class="autofill-actions">
        <button type="button" class="button" data-copy-role>Copy role</button>
        <button type="button" class="button" data-remove-entry>Remove role</button>
        <span role="status" data-copy-status></span>
    </div>
</fieldset>
