@model ExtractionReviewViewModel
@{
    ViewData["Title"] = "Review extracted application";
}

<section class="form-page extraction-page">
    <div class="shell review-shell">
        <a class="back-link" asp-action="@Model.ImportAction">← @Model.ImportAgainLabel</a>
        <div class="form-heading review-heading">
            <div>
                <p class="eyebrow">Review before saving</p>
                <h1>Check the extracted details.</h1>
                <p>Every field is editable. Blank fields mean the text did not provide clear evidence.</p>
            </div>
            <span class="review-status">Draft · expires in 24 hours</span>
        </div>

        @if (Model.Warnings.Count > 0)
        {
            <section class="extraction-warnings" aria-labelledby="extraction-warning-title">
                <h2 id="extraction-warning-title">Things to check</h2>
                <ul>
                    @foreach (var warning in Model.Warnings)
                    {
                        <li>@warning</li>
                    }
                </ul>
            </section>
        }

        <div class="extraction-review-grid">
            <aside class="source-card" aria-labelledby="original-text-title">
                <div class="source-card-heading">
                    <div><p class="mini-label">Original source</p><h2 id="original-text-title">@Model.OriginalSourceLabel</h2></div>
                    <div class="source-card-actions">
                        <span>Read only</span>
                        <button class="source-copy-button"
                                type="button"
                                data-copy-source
                                data-copy-target="original-source-text"
                                data-copy-status="original-source-copy-status"
                                aria-label="Copy the complete original source"
                                title="Copy original source">
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path d="M8 7.5V5.75A2.75 2.75 0 0 1 10.75 3h7.5A2.75 2.75 0 0 1 21 5.75v7.5A2.75 2.75 0 0 1 18.25 16H16.5" />
                                <rect x="3" y="8" width="13" height="13" rx="2.75" />
                            </svg>
                        </button>
                        <span id="original-source-copy-status" class="visually-hidden" role="status" aria-live="polite"></span>
                    </div>
                </div>
                <pre id="original-source-text">@Model.SourceText</pre>
            </aside>

            <form method="post" class="editor-card review-editor">
                <input asp-for="DraftId" type="hidden" />
                <div asp-validation-summary="All" class="validation-summary" role="alert"
                     tabindex="@(!ViewData.ModelState.IsValid ? "-1" : null)"
                     autofocus="@(!ViewData.ModelState.IsValid)"></div>

                <section class="review-section" aria-labelledby="core-details-title">
                    <p class="mini-label">Application essentials</p>
                    <h2 id="core-details-title">Core details</h2>
                    <div class="review-form-grid">
                        <div class="field form-span-2">
                            <label asp-for="RoleTitle"></label><input asp-for="RoleTitle" /><span asp-validation-for="RoleTitle" class="field-error"></span>
                            @if (Model.EvidenceFor(nameof(Model.RoleTitle)) is not null) { <small class="evidence-note">Evidence: @Model.EvidenceFor(nameof(Model.RoleTitle))</small> }
                        </div>
                        <div class="field">
                            <label asp-for="CompanyName"></label><input asp-for="CompanyName" autocomplete="organization" /><span asp-validation-for="CompanyName" class="field-error"></span>
                            @if (Model.EvidenceFor(nameof(Model.CompanyName)) is not null) { <small class="evidence-note">Evidence: @Model.EvidenceFor(nameof(Model.CompanyName))</small> }
                            <small class="field-help">A new company is created unless you explicitly choose an existing match below.</small>
                        </div>
                        <div class="field">
                            <label asp-for="CompanyLocation"></label><input asp-for="CompanyLocation" autocomplete="address-level2" /><span asp-validation-for="CompanyLocation" class="field-error"></span>
                            @if (Model.EvidenceFor(nameof(Model.CompanyLocation)) is not null) { <small class="evidence-note">Evidence: @Model.EvidenceFor(nameof(Model.CompanyLocation))</small> }
                        </div>
                        @if (Model.CompanySuggestions.Count > 0)
                        {
                            <fieldset class="company-reuse-notice form-span-2">
                                <legend>Same company detected</legend>
                                <p>We found an existing company with the same or a closely matching name. Choose where this application belongs.</p>
                                <div class="company-reuse-options">
                                    <label>
                                        <input type="radio"
                                               name="ExistingCompanyId"
                                               value=""
                                               checked="@(Model.ExistingCompanyId is null)" />
                                        <span>
                                            <strong>Keep extracted company</strong>
                                            <small>Create a separate company using the reviewed name and location.</small>
                                        </span>
                                    </label>
                                    @foreach (var company in Model.CompanySuggestions)
                                    {
                                        <label>
                                            <input type="radio"
                                                   name="ExistingCompanyId"
                                                   value="@company.Id"
                                                   checked="@(Model.ExistingCompanyId == company.Id)" />
                                            <span>
                                                <strong>Use @company.Name</strong>
                                                <small>@(string.IsNullOrWhiteSpace(company.Location) ? "No location recorded" : company.Location)</small>
                                            </span>
                                        </label>
                                    }
                                </div>
                                <span asp-validation-for="ExistingCompanyId" class="field-error"></span>
                            </fieldset>
                        }
                        <div class="field">
                            <label asp-for="AppliedOn"></label><input asp-for="AppliedOn" type="date" /><span asp-validation-for="AppliedOn" class="field-error"></span>
                            @if (Model.EvidenceFor(nameof(Model.AppliedOn)) is not null) { <small class="evidence-note">Evidence: @Model.EvidenceFor(nameof(Model.AppliedOn))</small> } else { <small class="field-help">Defaults to today when the posting does not state it.</small> }
                        </div>
                        <div class="field">
                            <label asp-for="WorkplaceMode"></label><input asp-for="WorkplaceMode" placeholder="Remote, hybrid, or on-site" /><span asp-validation-for="WorkplaceMode" class="field-error"></span>
                            @if (Model.EvidenceFor(nameof(Model.WorkplaceMode)) is not null) { <small class="evidence-note">Evidence: @Model.EvidenceFor(nameof(Model.WorkplaceMode))</small> }
                        </div>
                        <div class="field form-span-2">
                            <label asp-for="SourceUrl"></label><input asp-for="SourceUrl" type="url" inputmode="url" placeholder="https://…" /><span asp-validation-for="SourceUrl" class="field-error"></span>
                            @if (Model.EvidenceFor(nameof(Model.SourceUrl)) is not null) { <small class="evidence-note">Evidence: @Model.EvidenceFor(nameof(Model.SourceUrl))</small> }
                        </div>
                        <div class="field form-span-2">
                            <label asp-for="ApplicationPortalUrl"></label><input asp-for="ApplicationPortalUrl" type="url" inputmode="url" placeholder="https://…" /><span asp-validation-for="ApplicationPortalUrl" class="field-error"></span>
                            <small class="field-help">Optional and manual. Add the employer's candidate portal where you check this application's progress.</small>
                        </div>
                    </div>
                </section>

                <section class="review-section" aria-labelledby="extra-details-title">
                    <p class="mini-label">Optional evidence</p>
                    <h2 id="extra-details-title">Posting details</h2>
                    <div class="review-form-grid">
                        <div class="field"><label asp-for="SourceSite"></label><input asp-for="SourceSite" /><span asp-validation-for="SourceSite" class="field-error"></span>@if (Model.EvidenceFor(nameof(Model.SourceSite)) is not null) { <small class="evidence-note">Evidence: @Model.EvidenceFor(nameof(Model.SourceSite))</small> }</div>
                        <div class="field"><label asp-for="JobReference"></label><input asp-for="JobReference" /><span asp-validation-for="JobReference" class="field-error"></span>@if (Model.EvidenceFor(nameof(Model.JobReference)) is not null) { <small class="evidence-note">Evidence: @Model.EvidenceFor(nameof(Model.JobReference))</small> }</div>
                        <div class="field"><label asp-for="SalaryText"></label><input asp-for="SalaryText" /><span asp-validation-for="SalaryText" class="field-error"></span>@if (Model.EvidenceFor(nameof(Model.SalaryText)) is not null) { <small class="evidence-note">Evidence: @Model.EvidenceFor(nameof(Model.SalaryText))</small> }</div>
                        <div class="field"><label asp-for="EmploymentType"></label><input asp-for="EmploymentType" /><span asp-validation-for="EmploymentType" class="field-error"></span>@if (Model.EvidenceFor(nameof(Model.EmploymentType)) is not null) { <small class="evidence-note">Evidence: @Model.EvidenceFor(nameof(Model.EmploymentType))</small> }</div>
                        <div class="field"><label asp-for="ClosingDate"></label><input asp-for="ClosingDate" type="date" /><span asp-validation-for="ClosingDate" class="field-error"></span>@if (Model.EvidenceFor(nameof(Model.ClosingDate)) is not null) { <small class="evidence-note">Evidence: @Model.EvidenceFor(nameof(Model.ClosingDate))</small> }</div>
                        <div class="field"><label asp-for="ContactName"></label><input asp-for="ContactName" autocomplete="name" /><span asp-validation-for="ContactName" class="field-error"></span>@if (Model.EvidenceFor(nameof(Model.ContactName)) is not null) { <small class="evidence-note">Evidence: @Model.EvidenceFor(nameof(Model.ContactName))</small> }</div>
                        <div class="field form-span-2"><label asp-for="ContactEmail"></label><input asp-for="ContactEmail" type="email" autocomplete="email" /><span asp-validation-for="ContactEmail" class="field-error"></span>@if (Model.EvidenceFor(nameof(Model.ContactEmail)) is not null) { <small class="evidence-note">Evidence: @Model.EvidenceFor(nameof(Model.ContactEmail))</small> }</div>
                        <div class="field form-span-2"><label asp-for="DescriptionText"></label><textarea asp-for="DescriptionText" rows="14" placeholder="The complete job description. Section headings and paragraph breaks are preserved."></textarea><span asp-validation-for="DescriptionText" class="field-error"></span>@if (Model.EvidenceFor(nameof(Model.DescriptionText)) is not null) { <small class="evidence-note">Evidence: @Model.EvidenceFor(nameof(Model.DescriptionText))</small> }</div>
                        <div class="field form-span-2"><label asp-for="Notes"></label><textarea asp-for="Notes" rows="5" placeholder="Your own notes about the application or next step."></textarea><span asp-validation-for="Notes" class="field-error"></span></div>
                    </div>
                </section>

                <label class="save-choice">
                    <input asp-for="IsSavedForever" />
                    <span><strong>Saved</strong><small>Saved applications are exempt from future automatic retention deletion.</small></span>
                </label>

                <div class="editor-actions">
                    <button class="button button-primary" type="submit">Confirm and add application</button>
                    <button class="button button-secondary" type="submit" form="cancel-import" formnovalidate>Cancel import</button>
                </div>
            </form>
        </div>

        <form id="cancel-import" method="post" asp-action="Cancel" asp-route-id="@Model.DraftId"></form>
    </div>
</section>
<script src="~/js/source-copy.js" asp-append-version="true"></script>
