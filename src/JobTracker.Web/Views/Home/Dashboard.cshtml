@model DashboardSnapshot
@{
    ViewData["Title"] = "Dashboard";
    var stageSegments = Model.Stages
        .Select((item, index) => (Item: item, ColorIndex: index))
        .Where(item => item.Item.Count > 0)
        .ToList();
    var pipelineCount = Model.Stages.Sum(item => item.Count);
    var overdueCount = Model.OpenTasks.Count(item => item.IsOverdue);
    var currentMonth = Model.Months[^1];

    static string DonutPoint(double percentage)
    {
        const double centre = 21;
        const double radius = 15.9155;
        var radians = (percentage * 3.6 - 90) * Math.PI / 180;
        var x = centre + radius * Math.Cos(radians);
        var y = centre + radius * Math.Sin(radians);
        return $"{x.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)} {y.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)}";
    }

    static string DonutArc(double startPercentage, double percentage)
    {
        const double radius = 15.9155;
        var endPercentage = startPercentage + percentage;
        var largeArc = percentage > 50 ? 1 : 0;
        return $"M {DonutPoint(startPercentage)} A {radius} {radius} 0 {largeArc} 1 {DonutPoint(endPercentage)}";
    }
}

<section class="workspace-hero">
    <div class="shell workspace-heading">
        <div>
            <h1>Dashboard</h1>
            <p>See your applications, upcoming actions, and recent progress from @Model.Window.StartsOn.ToString("d MMM") – @Model.Window.EndsOn.ToString("d MMM yyyy").</p>
        </div>
        <div class="dashboard-hero-actions">
            <p>Welcome back, <strong>@Model.DisplayName</strong>.</p>
            <a class="button button-primary" asp-controller="Applications" asp-action="Create">+ Add application</a>
        </div>
    </div>
</section>

<section class="workspace-content dashboard-workspace">
    <div class="shell">
        <div class="dashboard-metrics" aria-label="Three-month summary">
            <article class="dashboard-metric-card">
                <span>Applications</span>
                <strong>@Model.ApplicationCount</strong>
                <small>Across three calendar months</small>
            </article>
            <article class="dashboard-metric-card">
                <span>Employer responses</span>
                <strong>@Model.ResponseCount</strong>
                <small>Meaningful responses recorded</small>
            </article>
            <article class="dashboard-metric-card">
                <span>Interviews</span>
                <strong>@Model.InterviewCount</strong>
                <small>Scheduled inside this window</small>
            </article>
            <article class="dashboard-metric-card attention-metric">
                <span>Needs attention</span>
                <strong>@(overdueCount + Model.GhostingAttention.Count + Model.DeletionScheduled.Count)</strong>
                <small>Tasks, ghosting checks, and deletion warnings</small>
            </article>
        </div>

        <div class="dashboard-months" aria-label="Applications by calendar month">
            @foreach (var month in Model.Months)
            {
                <article class="dashboard-month @(month == currentMonth ? "is-current" : null)">
                    <span>@month.Month.Label</span>
                    <strong>@month.ApplicationCount</strong>
                    <small>@(month.ApplicationCount == 1 ? "application" : "applications")</small>
                </article>
            }
        </div>

        <div class="dashboard-grid">
            <div class="dashboard-main-column">
                <article class="dashboard-panel">
                    <div class="dashboard-panel-heading">
                        <div><p class="mini-label">Pipeline · recent + saved</p><h2>Where applications stand</h2></div>
                        <a class="text-link" asp-controller="Applications" asp-action="Index">View all applications</a>
                    </div>
                    @if (pipelineCount == 0)
                    {
                        <div class="dashboard-empty"><strong>No recent or saved applications yet.</strong><span>Add one when you are ready.</span></div>
                    }
                    else
                    {
                        <div class="pipeline-chart" data-pipeline-chart>
                            <div class="pipeline-donut-wrap">
                                <svg class="pipeline-donut" viewBox="0 0 42 42" role="img" aria-labelledby="pipeline-chart-title pipeline-chart-description">
                                    <title id="pipeline-chart-title">Applications by pipeline stage</title>
                                    <desc id="pipeline-chart-description">@string.Join(", ", stageSegments.Select(item => $"{item.Item.Label}: {item.Item.Count}"))</desc>
                                    <circle class="pipeline-donut-track" cx="21" cy="21" r="15.9155" pathLength="100"></circle>
                                    @{
                                        var cumulativePercentage = 0d;
                                    }
                                    @for (var index = 0; index < stageSegments.Count; index++)
                                    {
                                        var stage = stageSegments[index];
                                        var percentage = stage.Item.Count * 100d / pipelineCount;
                                        var accessibleLabel = $"{stage.Item.Label}: {stage.Item.Count} {(stage.Item.Count == 1 ? "application" : "applications")}";
                                        if (stageSegments.Count == 1)
                                        {
                                            <circle class="pipeline-donut-segment pipeline-stage-@stage.ColorIndex"
                                                    cx="21" cy="21" r="15.9155"
                                                    tabindex="0"
                                                    role="img"
                                                    aria-label="@accessibleLabel"
                                                    data-pipeline-label="@stage.Item.Label"
                                                    data-pipeline-count="@stage.Item.Count">
                                                <title>@accessibleLabel</title>
                                            </circle>
                                        }
                                        else
                                        {
                                            <path class="pipeline-donut-segment pipeline-stage-@stage.ColorIndex"
                                                  d="@DonutArc(cumulativePercentage, percentage)"
                                                  tabindex="0"
                                                  role="img"
                                                  aria-label="@accessibleLabel"
                                                  data-pipeline-label="@stage.Item.Label"
                                                  data-pipeline-count="@stage.Item.Count">
                                                <title>@accessibleLabel</title>
                                            </path>
                                        }
                                        cumulativePercentage += percentage;
                                    }
                                </svg>
                                <div class="pipeline-donut-centre" aria-hidden="true">
                                    <div class="pipeline-donut-total" data-pipeline-total>
                                        <strong>@pipelineCount</strong>
                                        <span>Recent + saved</span>
                                    </div>
                                    <div class="pipeline-donut-tooltip" data-pipeline-tooltip hidden>
                                        <strong data-pipeline-tooltip-label></strong>
                                        <span data-pipeline-tooltip-count></span>
                                    </div>
                                </div>
                            </div>
                            <ul class="pipeline-legend" aria-label="Pipeline stage totals">
                                @for (var index = 0; index < stageSegments.Count; index++)
                                {
                                    var stage = stageSegments[index];
                                    <li>
                                        <span class="pipeline-legend-swatch pipeline-stage-@stage.ColorIndex" aria-hidden="true"></span>
                                        <span>@stage.Item.Label</span>
                                        <strong>@stage.Item.Count</strong>
                                    </li>
                                }
                            </ul>
                        </div>
                        <div class="outcome-chips" aria-label="Current outcomes">
                            @foreach (var outcome in Model.Outcomes.Where(item => item.Count > 0))
                            {
                                <span><strong>@outcome.Count</strong> @outcome.Label</span>
                            }
                        </div>
                    }
                </article>

                <article class="dashboard-panel">
                    <div class="dashboard-panel-heading">
                        <div><p class="mini-label">Recent activity</p><h2>The latest movement</h2></div>
                    </div>
                    @if (Model.RecentActivity.Count == 0)
                    {
                        <div class="dashboard-empty"><strong>No recent activity.</strong><span>Status changes and interactions will appear here.</span></div>
                    }
                    else
                    {
                        <ol class="dashboard-activity-list">
                            @foreach (var item in Model.RecentActivity)
                            {
                                <li>
                                    <span class="activity-marker" aria-hidden="true"></span>
                                    <div>
                                        <p class="activity-kind">@item.Kind</p>
                                        <a asp-controller="Applications" asp-action="Details" asp-route-id="@item.ApplicationId">@item.RoleTitle</a>
                                        <span>@item.Summary@(item.CompanyName is null ? null : $" · {item.CompanyName}")</span>
                                    </div>
                                    <time datetime="@item.OccurredAt.ToString("O")">@ApplicationTime.ToLocal(item.OccurredAt, Model.Window.TimeZoneId).ToString("d MMM, h:mm tt")</time>
                                </li>
                            }
                        </ol>
                    }
                </article>

                <article class="dashboard-panel">
                    <div class="dashboard-panel-heading">
                        <div><p class="mini-label">Recent applications</p><h2>Inside this dashboard window</h2></div>
                    </div>
                    @if (Model.RecentApplications.Count == 0)
                    {
                        <div class="dashboard-empty"><strong>The window is clear.</strong><span>Older saved records remain available from Applications.</span></div>
                    }
                    else
                    {
                        <div class="dashboard-application-list">
                            @foreach (var application in Model.RecentApplications)
                            {
                                <a asp-controller="Applications" asp-action="Details" asp-route-id="@application.Id">
                                    <div>
                                        <strong>@application.RoleTitle</strong>
                                        <span>@(application.CompanyName ?? "No company") · @application.AppliedOn.ToString("d MMM yyyy")</span>
                                    </div>
                                    <span class="dashboard-state">@ApplicationDisplay.Stage(application.Stage) · @ApplicationDisplay.Outcome(application.Outcome)</span>
                                </a>
                            }
                        </div>
                    }
                </article>
            </div>

            <aside class="dashboard-side-column">
                <article class="dashboard-panel action-summary-panel">
                    <div class="dashboard-panel-heading">
                        <div><p class="mini-label">Attention</p><h2>What needs you next</h2></div>
                        <a class="text-link" asp-action="ActionCentre">Open Action Centre</a>
                    </div>
                    @if (Model.GhostingAttention.Count == 0 && Model.OpenTasks.Count == 0 && Model.DeletionScheduled.Count == 0)
                    {
                        <div class="dashboard-empty"><strong>Nothing urgent.</strong><span>Your next follow-ups will appear here.</span></div>
                    }
                    else
                    {
                        <ul class="dashboard-action-list">
                            @foreach (var item in Model.DeletionScheduled.Take(3))
                            {
                                <li class="attention-row deletion-attention-row">
                                    <span class="attention-icon" aria-hidden="true">!</span>
                                    <div>
                                        <strong>@item.RoleTitle</strong>
                                        <span>Deletion scheduled after @ApplicationTime.Display(item.DeletionScheduledAt, Model.Window.TimeZoneId)</span>
                                    </div>
                                </li>
                            }
                            @foreach (var item in Model.GhostingAttention.Take(3))
                            {
                                <li class="attention-row">
                                    <span class="attention-icon" aria-hidden="true">!</span>
                                    <div><strong>@item.RoleTitle</strong><span>@(item.Kind == GhostingAttentionKind.ConfirmGhosted ? "Ready for your Ghosted decision" : $"No response after {item.DaysSinceApplied} days")</span></div>
                                </li>
                            }
                            @foreach (var task in Model.OpenTasks.Take(4))
                            {
                                <li>
                                    <span class="task-icon" aria-hidden="true">✓</span>
                                    <div><strong>@task.Title</strong><span>@task.RoleTitle · @(task.DueAt is null ? "No due date" : $"{(task.IsOverdue ? "Overdue" : "Due")} {ApplicationTime.ToLocal(task.DueAt.Value, Model.Window.TimeZoneId):d MMM, h:mm tt}")</span></div>
                                </li>
                            }
                        </ul>
                    }
                </article>

                <article class="dashboard-panel">
                    <div class="dashboard-panel-heading"><div><p class="mini-label">Coming up</p><h2>Appointments</h2></div></div>
                    @if (Model.UpcomingAppointments.Count == 0)
                    {
                        <div class="dashboard-empty"><strong>No upcoming appointments.</strong><span>Interviews and calls will appear here.</span></div>
                    }
                    else
                    {
                        <ul class="dashboard-appointment-list">
                            @foreach (var appointment in Model.UpcomingAppointments.Take(5))
                            {
                                <li>
                                    <time datetime="@appointment.StartsAt.ToString("O")"><strong>@ApplicationTime.ToLocal(appointment.StartsAt, appointment.TimeZoneId).ToString("dd")</strong><span>@ApplicationTime.ToLocal(appointment.StartsAt, appointment.TimeZoneId).ToString("MMM")</span></time>
                                    <div><strong>@ApplicationDisplay.Appointment(appointment.Type)</strong><a asp-controller="Applications" asp-action="Details" asp-route-id="@appointment.ApplicationId">@appointment.RoleTitle</a><span>@ApplicationTime.ToLocal(appointment.StartsAt, appointment.TimeZoneId).ToString("h:mm tt")</span></div>
                                </li>
                            }
                        </ul>
                    }
                </article>
            </aside>
        </div>
    </div>
</section>

<script src="~/js/dashboard-pipeline.js" asp-append-version="true" defer></script>
