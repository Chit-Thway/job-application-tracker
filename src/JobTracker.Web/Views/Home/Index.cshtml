@{
    ViewData["Title"] = "Welcome";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var currentMonth = DateTime.Today;
    var months = Enumerable.Range(0, 3)
        .Select(offset => currentMonth.AddMonths(offset - 2).ToString("MMM"))
        .ToArray();
}

<section class="hero">
    <div class="shell hero-grid">
        <div class="hero-copy">
            <p class="eyebrow">Private job-search workspace</p>
            <h1>Your job search,<br /><span>brought into focus.</span></h1>
            <p class="hero-lead">
                Track applications, follow-ups, contacts, and interviews in one deliberate workspace—without
                losing the opportunities you want to keep.
            </p>
            <div class="button-row">
                @if (isAuthenticated)
                {
                    <a class="button button-primary" asp-controller="Home" asp-action="Dashboard">
                        Open your dashboard
                        <span aria-hidden="true">→</span>
                    </a>
                    <a class="button button-secondary" asp-controller="Applications" asp-action="Create">Add an application</a>
                }
                else
                {
                    <a class="button button-primary" asp-controller="Demo" asp-action="Index">
                        Explore the live demo
                        <span aria-hidden="true">→</span>
                    </a>
                    <a class="button button-secondary" asp-controller="Account" asp-action="Login">Private sign in</a>
                }
            </div>
            <p class="foundation-caption">
                <span aria-hidden="true">●</span>
                Private accounts are invitation-only. The public demo contains synthetic data only.
            </p>
        </div>

        <aside class="window-card" aria-labelledby="window-title">
            <div class="window-topline">
                <div>
                    <p class="mini-label">One focused dashboard</p>
                    <h2 id="window-title">Your three-month window</h2>
                </div>
                <span class="window-badge">Private</span>
            </div>
            <div class="month-track" aria-label="Current dashboard month range">
                @foreach (var month in months)
                {
                    <span class="month-chip @(month == months[^1] ? "is-current" : string.Empty)">@month</span>
                }
            </div>
            <div class="metric-grid" aria-label="Tracker principles">
                <div class="metric">
                    <span>Dashboard</span>
                    <strong>3 mo</strong>
                </div>
                <div class="metric">
                    <span>Saved records</span>
                    <strong>Kept</strong>
                </div>
                <div class="metric">
                    <span>Deletion warning</span>
                    <strong>3–14 d</strong>
                </div>
            </div>
            <div class="next-action-preview">
                <span class="preview-icon" aria-hidden="true">✓</span>
                <div>
                    <strong>Your next action stays visible</strong>
                    <span>Follow-ups and appointments meet in one calm queue.</span>
                </div>
            </div>
        </aside>
    </div>
</section>

<section class="value-section" aria-labelledby="value-title">
    <div class="shell">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Designed around the real workflow</p>
                <h2 id="value-title">Less admin. More momentum.</h2>
            </div>
            <p>Capture the opportunity once, then let its status, history, tasks, and scheduled time stay connected.</p>
        </div>

        <div class="value-grid">
            <article class="value-card value-card-blue">
                <span class="card-number">01</span>
                <div class="card-symbol" aria-hidden="true">◎</div>
                <h3>Capture applications quickly</h3>
                <p>Add one manually, paste a job description, import a public page, or capture the active browser tab.</p>
                @if (isAuthenticated)
                {
                    <a asp-controller="Applications" asp-action="Create">Add an application <span aria-hidden="true">→</span></a>
                }
                else
                {
                    <a asp-controller="Demo" asp-action="Applications">See sample applications <span aria-hidden="true">→</span></a>
                }
            </article>
            <article class="value-card value-card-violet">
                <span class="card-number">02</span>
                <div class="card-symbol" aria-hidden="true">◇</div>
                <h3>Keep the full story</h3>
                <p>Status changes, contacts, interactions, tasks, appointments, and notes stay attached to the application.</p>
                <a asp-controller="Demo" asp-action="Applications">Explore the workflow <span aria-hidden="true">→</span></a>
            </article>
            <article class="value-card value-card-green">
                <span class="card-number">03</span>
                <div class="card-symbol" aria-hidden="true">↗</div>
                <h3>Know the next move</h3>
                <p>See overdue tasks, upcoming appointments, ghosting decisions, and deletion warnings without rebuilding context.</p>
                <a asp-controller="Demo" asp-action="ActionCentre">Open the sample Action Centre <span aria-hidden="true">→</span></a>
            </article>
        </div>
    </div>
</section>

<section class="foundation-section" aria-labelledby="privacy-title">
    <div class="shell foundation-grid">
        <div>
            <p class="eyebrow">Private by design</p>
            <h2 id="privacy-title">Your real search stays separate.</h2>
            <p>
                Accounts require a one-time invitation and verified email. Private records are owner-isolated, while
                the public portfolio demo is generated entirely from fictional data.
            </p>
            <p><a class="foundation-link" asp-controller="Home" asp-action="Privacy">Read the privacy summary <span aria-hidden="true">→</span></a></p>
        </div>
        <ul class="check-list">
            <li><span aria-hidden="true">✓</span> Invitation-only registration and verified email</li>
            <li><span aria-hidden="true">✓</span> Owner-isolated applications and connected records</li>
            <li><span aria-hidden="true">✓</span> Configurable retention timing and transparent deletion dates</li>
            <li><span aria-hidden="true">✓</span> Synthetic public demo that never reads private tables</li>
        </ul>
    </div>
</section>
