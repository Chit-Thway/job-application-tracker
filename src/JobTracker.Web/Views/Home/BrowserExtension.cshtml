@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Browser extension";
    var storeUrl = Configuration["BrowserExtension:ChromeWebStoreUrl"];
    var isPublished = Uri.TryCreate(storeUrl, UriKind.Absolute, out var parsedStoreUrl)
        && parsedStoreUrl.Scheme == Uri.UriSchemeHttps;
}

<section class="workspace-hero">
    <div class="shell workspace-heading">
        <div>
            <h1>Browser extension</h1>
            <p>Extract a job advertisement for review or fill an application using your saved applicant profile.</p>
        </div>
        @if (isPublished)
        {
            <a class="button button-primary" href="@storeUrl" rel="noreferrer">Install from Chrome Web Store</a>
        }
        else
        {
            <span class="extension-store-pending" role="status">Chrome Web Store review in progress</span>
        }
    </div>
</section>

<section class="workspace-content extension-workspace">
    <div class="shell extension-layout">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <article class="detail-card">
                <h2>Autofill profile</h2>
                <p>Save your contact details, work history and qualifications for supported application forms.</p>
                <a class="button button-primary" asp-controller="Autofill" asp-action="Profile">Manage autofill profile</a>
            </article>
        }
        <article class="detail-card extension-overview">
            <p class="mini-label">One deliberate click</p>
            <h2>Capture first. Confirm later.</h2>
            <ol class="extension-steps">
                <li><strong>Open a job advertisement.</strong><span>Keep the job page visible in the active Chrome tab.</span></li>
                <li><strong>Choose Extract.</strong><span>Extract the job ad into a private review draft.</span></li>
                <li><strong>Check every suggested field.</strong><span>The tracker creates a private 24-hour draft and never saves an application automatically.</span></li>
            </ol>
        </article>

        <div class="extension-trust-grid">
            <article class="detail-card">
                <p class="mini-label">Minimal permissions</p>
                <h2>Only the tab you choose</h2>
                <p>The extension accesses the active tab when you choose an action. A connection to the tracker lets it read your saved profile when you choose Fill.</p>
            </article>
            <article class="detail-card">
                <p class="mini-label">No hidden activity</p>
                <h2>No background browsing</h2>
                <p>Extract and Fill run from the popup. When you fill a form, the employer's page can read the values placed into it.</p>
            </article>
            <article class="detail-card">
                <p class="mini-label">Review boundary</p>
                <h2>Nothing is auto-saved</h2>
                <p>The capture opens an editable draft inside your authenticated tracker. You decide whether it becomes an application.</p>
            </article>
        </div>

        <p class="extension-policy-link"><a class="foundation-link" asp-action="BrowserExtensionPrivacy">Read the browser extension privacy notice <span aria-hidden="true">→</span></a></p>
    </div>
</section>
