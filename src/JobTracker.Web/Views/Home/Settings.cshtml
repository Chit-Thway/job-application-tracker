@model RetentionSettingsSnapshot
@{
    ViewData["Title"] = "Settings";
}

<section class="workspace-hero settings-hero">
    <div class="shell workspace-heading">
        <div>
            <p class="eyebrow">Settings and privacy</p>
            <h1>Know exactly<br />what gets kept.</h1>
            <p>Retention dates use your configured timezone: <strong>@Model.TimeZoneId</strong>.</p>
        </div>
        <a class="button button-primary" asp-controller="Applications" asp-action="Index">Review applications</a>
    </div>
</section>

<section class="workspace-content settings-workspace">
    <div class="shell settings-layout">
        <article class="detail-card settings-retention-card">
            <p class="mini-label">Automatic retention</p>
            <h2>@Model.RetentionMonths month@(Model.RetentionMonths == 1 ? string.Empty : "s"), then a full @Model.DeletionGraceDays-day warning.</h2>
            <form method="post" asp-action="UpdateRetentionSettings" class="retention-settings-form">
                <div class="retention-setting-fields">
                    <div class="field">
                        <label for="retention-months">Unsaved application period</label>
                        <select id="retention-months" name="retentionMonths">
                            @foreach (var months in RetentionPolicy.AllowedRetentionMonths)
                            {
                                <option value="@months" selected="@(months == Model.RetentionMonths)">@months month@(months == 1 ? string.Empty : "s")</option>
                            }
                        </select>
                        <small class="field-help">After this calendar period, an unsaved application becomes eligible for automatic deletion. Three months is the maximum.</small>
                    </div>
                    <div class="field">
                        <label for="deletion-grace-days">Deletion warning period</label>
                        <select id="deletion-grace-days" name="deletionGraceDays">
                            @foreach (var days in RetentionPolicy.AllowedGracePeriodDays)
                            {
                                <option value="@days" selected="@(days == Model.DeletionGraceDays)">@days days</option>
                            }
                        </select>
                        <small class="field-help">The application remains recoverable by saving it throughout this warning period.</small>
                    </div>
                </div>
                <button class="button button-primary" type="submit">Save retention settings</button>
            </form>
            <ol class="retention-steps">
                <li><strong>Recent</strong><span>An unsaved application stays untouched until its @Model.RetentionMonths-month calendar anniversary.</span></li>
                <li><strong>Deletion scheduled</strong><span>When eligible, it receives an exact automatic-deletion time @Model.DeletionGraceDays full days later.</span></li>
                <li><strong>Saved</strong><span>Saving immediately cancels any pending deletion and keeps the application indefinitely.</span></li>
            </ol>
            <p class="retention-note">Changing these settings safely recalculates your pending schedules from the current time and never deletes anything immediately. The cleanup function checks the saved state and due time again inside the deletion transaction.</p>
        </article>

        <aside class="settings-side">
            <article class="detail-card">
                <p class="mini-label">Your records</p>
                <h2>Retention overview</h2>
                <dl class="settings-counts">
                    <div><dt>Saved</dt><dd>@Model.SavedCount</dd></div>
                    <div><dt>Recent</dt><dd>@Model.RecentCount</dd></div>
                    <div><dt>Awaiting schedule</dt><dd>@Model.EligibleCount</dd></div>
                    <div><dt>Deletion scheduled</dt><dd>@Model.DeletionScheduledCount</dd></div>
                </dl>
            </article>

            <article class="detail-card">
                <p class="mini-label">Database scheduler</p>
                <h2>Retention service</h2>
                @if (Model.LastRun is null)
                {
                    <p>No retention run has been recorded yet.</p>
                }
                else if (Model.LastRun.Succeeded)
                {
                    <p class="service-health service-health-good">Last run succeeded.</p>
                    <p>@ApplicationTime.Display(Model.LastRun.CompletedAt, Model.TimeZoneId)</p>
                }
                else
                {
                    <p class="service-health service-health-warning">The last run reported a failure.</p>
                    <p>@ApplicationTime.Display(Model.LastRun.CompletedAt, Model.TimeZoneId) · code @(Model.LastRun.ErrorCode ?? "unknown")</p>
                }
                <p class="retention-note">Operational history stores timestamps, counts, success state, and a short database error code—never role titles, company names, or source text.</p>
            </article>
        </aside>
    </div>

    <div class="shell settings-policy-list" aria-label="Policies and terms">
        <details class="detail-card settings-policy-disclosure">
            <summary>
                <span class="settings-policy-title">Privacy Policy</span>
                <span class="settings-policy-hint">What the tracker stores, why it is used, and your choices.</span>
            </summary>
            <div class="settings-policy-content">
                <p>The tracker stores the account details needed to secure your private workspace and the job-search records that you enter, import, or approve. Private applications, companies, notes, contacts, tasks, appointments, and source text are never included in the public synthetic demo.</p>
                <p>Your information is used only to provide the tracker, account-security, retention, and transactional-email features. It is not sold, used for advertising, or sent to an external AI service.</p>
                <p>You can edit or delete individual records in the tracker. For account-wide access or deletion, email <a class="inline-link" href="mailto:redacted@example.invalid">redacted@example.invalid</a>.</p>
                <p><a class="inline-link" asp-controller="Home" asp-action="Privacy">Read the full Privacy Policy</a> or review the <a class="inline-link" asp-controller="Home" asp-action="BrowserExtensionPrivacy">browser extension privacy notice</a>.</p>
            </div>
        </details>

        <details class="detail-card settings-policy-disclosure">
            <summary>
                <span class="settings-policy-title">Cookie Consent</span>
                <span class="settings-policy-hint">How essential cookies and local browser preferences are used.</span>
            </summary>
            <div class="settings-policy-content">
                <p>The tracker uses only strictly necessary cookies to keep you signed in and protect submitted forms against forgery. These cookies are required for the private authenticated service to work and are not used for advertising or cross-site tracking.</p>
                <p>Your theme and preferred applications view are stored locally in your browser. This preference data stays on that device and can be cleared through your browser settings.</p>
                <p>There are currently no optional analytics or advertising cookies to accept or reject. If optional cookies are introduced later, the tracker will request a separate choice before enabling them.</p>
                <p><a class="inline-link" asp-controller="Home" asp-action="Cookies">Read the full Cookie Policy</a>.</p>
            </div>
        </details>

        <details class="detail-card settings-policy-disclosure">
            <summary>
                <span class="settings-policy-title">Terms of Service</span>
                <span class="settings-policy-hint">The rules and practical limits for using the tracker.</span>
            </summary>
            <div class="settings-policy-content">
                <p>Job Application Tracker is a private productivity tool for registered users. Keep your account secure, submit only information you are authorised to use, and do not attempt to disrupt the service or access another person's records.</p>
                <p>Imported and extracted job details are provided as an editable convenience. You are responsible for reviewing their accuracy before saving or relying on them. The tracker does not provide employment, legal, or financial advice and does not guarantee job-search outcomes or uninterrupted availability.</p>
                <p>You may stop using the service at any time and request account deletion by emailing <a class="inline-link" href="mailto:redacted@example.invalid">redacted@example.invalid</a>. Access may be suspended when necessary to protect users, data, or the service.</p>
                <p><a class="inline-link" asp-controller="Home" asp-action="Terms">Read the full Terms of Service</a>.</p>
            </div>
        </details>
    </div>
</section>
