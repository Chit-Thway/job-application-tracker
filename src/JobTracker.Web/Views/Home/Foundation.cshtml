@model FoundationPage
@{
    ViewData["Title"] = Model.NavigationLabel;
}

<section class="page-hero">
    <div class="shell">
        <a class="back-link" asp-controller="Home" asp-action="Index"><span aria-hidden="true">←</span> Foundation home</a>
        <div class="page-heading-grid">
            <div>
                <p class="eyebrow">@Model.Eyebrow</p>
                <h1>@Model.Title</h1>
                <p class="page-lead">@Model.Description</p>
            </div>
            <div class="foundation-pill">
                <span class="status-dot" aria-hidden="true"></span>
                Foundation preview
            </div>
        </div>
    </div>
</section>

<section class="page-content">
    <div class="shell preview-grid">
        <article class="preview-panel">
            <div class="preview-toolbar">
                <div>
                    <span class="preview-kicker">Planned experience</span>
                    <h2>@Model.NavigationLabel</h2>
                </div>
                <span class="preview-route">@Model.Route</span>
            </div>
            <ul class="preview-list">
                @foreach (var item in Model.PreviewItems)
                {
                    <li>
                        <span class="preview-check" aria-hidden="true">✓</span>
                        <span>@item</span>
                    </li>
                }
            </ul>
            <div class="skeleton-preview" aria-hidden="true">
                <span class="skeleton-line skeleton-line-short"></span>
                <span class="skeleton-line"></span>
                <span class="skeleton-line skeleton-line-medium"></span>
                <div class="skeleton-cards">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </div>
        </article>

        <aside class="not-live-card">
            <span class="not-live-icon" aria-hidden="true">i</span>
            <p class="mini-label">Not active yet</p>
            <h2>This page is intentionally a placeholder.</h2>
            <p>
                The navigation and responsive layout are ready, but no form, login, application data,
                is not implemented yet. Private access and the database foundation are now connected.
            </p>
            <div class="milestone-note">
                <strong>Next step</strong>
                <span>@Model.NextMilestone</span>
            </div>
            <a class="text-link" asp-controller="Home" asp-action="Index">Return to the foundation overview <span aria-hidden="true">→</span></a>
        </aside>
    </div>
</section>
