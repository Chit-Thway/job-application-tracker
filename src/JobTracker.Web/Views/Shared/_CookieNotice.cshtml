<aside class="cookie-notice" data-cookie-notice hidden tabindex="-1" aria-labelledby="cookie-notice-title">
    <div>
        <strong id="cookie-notice-title">Essential cookies only</strong>
        <p>We use security cookies for sign-in and protected forms, plus local storage for preferences. There are no analytics or advertising cookies.</p>
    </div>
    <div class="cookie-notice-actions">
        <a asp-controller="Home" asp-action="Cookies">Cookie Policy</a>
        <button class="button button-primary button-small" type="button" data-cookie-acknowledge>Use essential cookies</button>
    </div>
</aside>
