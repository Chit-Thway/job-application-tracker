@inject IHostEnvironment HostEnvironment
@{
    var section = ViewData["Section"] as string ?? string.Empty;
    var pageTitle = ViewData["Title"] as string;

    string NavClass(string key, bool action = false)
    {
        var classes = action ? "nav-action" : "nav-link";
        return section == key ? $"{classes} is-current" : classes;
    }

    string? AriaCurrent(string key) => section == key ? "page" : null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="A focused, private workspace for managing job applications and next actions." />
    <title>@(string.IsNullOrWhiteSpace(pageTitle) ? "Job Application Tracker" : $"{pageTitle} · Job Application Tracker")</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="site-header">
        <div class="shell header-inner">
            <a class="brand" asp-controller="Home" asp-action="Index" aria-label="Job Application Tracker home">
                <span class="brand-mark" aria-hidden="true">JT</span>
                <span class="brand-name">
                    <strong>Job Application</strong>
                    <span>Tracker</span>
                </span>
            </a>

            <div class="header-actions">
            <div class="site-nav" data-site-nav>
                <input class="site-nav-toggle" id="primary-navigation-toggle" type="checkbox" aria-label="Toggle primary navigation" />
                <label class="site-nav-summary" for="primary-navigation-toggle">
                    <span>Menu</span>
                    <span class="menu-lines" aria-hidden="true"></span>
                </label>
                <nav class="nav-panel" aria-label="Primary navigation">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a class="@NavClass("dashboard")" aria-current="@AriaCurrent("dashboard")" asp-controller="Home" asp-action="Dashboard">Dashboard</a>
                        <a class="@NavClass("applications")" aria-current="@AriaCurrent("applications")" asp-controller="Applications" asp-action="Index">Applications</a>
                        <a class="@NavClass("companies")" aria-current="@AriaCurrent("companies")" asp-controller="Companies" asp-action="Index">Companies</a>
                        <a class="@NavClass("actions")" aria-current="@AriaCurrent("actions")" asp-controller="Home" asp-action="ActionCentre">Action Centre</a>
                        <a class="@NavClass("settings")" aria-current="@AriaCurrent("settings")" asp-controller="Home" asp-action="Settings">Settings</a>
                        @if (User.IsInRole(AdminRole.Name))
                        {
                            <a class="@NavClass("admin")" aria-current="@AriaCurrent("admin")" asp-controller="Admin" asp-action="Index">Admin</a>
                        }
                    }
                    <a class="@NavClass("demo")" aria-current="@AriaCurrent("demo")" asp-controller="Demo" asp-action="Index">Demo</a>
                    <a class="@NavClass("extension")" aria-current="@AriaCurrent("extension")" asp-controller="Home" asp-action="BrowserExtension">Install extension</a>
                    @if (HostEnvironment.IsDevelopment())
                    {
                        <a class="nav-link" asp-controller="DevelopmentMail" asp-action="Index">Local messages</a>
                    }
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a class="@NavClass("add", action: true)" aria-current="@AriaCurrent("add")" asp-controller="Applications" asp-action="Create">
                            <span aria-hidden="true">+</span>
                            Add application
                        </a>
                        <form class="nav-form" method="post" asp-controller="Account" asp-action="Logout">
                            <button class="nav-link nav-button" type="submit">Sign out</button>
                        </form>
                    }
                    else
                    {
                        <a class="@NavClass("login", action: true)" aria-current="@AriaCurrent("login")" asp-controller="Account" asp-action="Login">Sign in</a>
                    }
                </nav>
            </div>

            <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch to dark mode" aria-pressed="false" title="Switch to dark mode">
                <span class="theme-toggle-track" aria-hidden="true">
                    <span class="theme-toggle-icon theme-toggle-sun">
                        <svg viewBox="0 0 24 24" focusable="false">
                            <circle cx="12" cy="12" r="3.5"></circle>
                            <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"></path>
                        </svg>
                    </span>
                    <span class="theme-toggle-icon theme-toggle-moon">
                        <svg viewBox="0 0 24 24" focusable="false">
                            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
                        </svg>
                    </span>
                    <span class="theme-toggle-thumb"></span>
                </span>
                <span class="visually-hidden" data-theme-label>Light theme active</span>
            </button>
            </div>
        </div>
    </header>

    <main id="main-content" tabindex="-1">
        @if (TempData["Success"] is string successMessage)
        {
            <div class="shell flash-wrap">
                <div class="flash-message" role="status">@successMessage</div>
            </div>
        }
        @if (TempData["Error"] is string errorMessage)
        {
            <div class="shell flash-wrap">
                <div class="flash-message flash-error" role="alert">@errorMessage</div>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="shell footer-inner">
            <div>
                <strong>Job Application Tracker</strong>
                <p>Built for a calmer, more deliberate job search.</p>
            </div>
            <div class="footer-status">
                <a asp-controller="Home" asp-action="Privacy">Privacy</a>
                <span aria-hidden="true">&middot;</span>
                <span><span class="status-dot" aria-hidden="true"></span> Private tracker &middot; Synthetic public demo</span>
            </div>
        </div>
    </footer>
    <script src="~/js/navigation.js" asp-append-version="true"></script>
</body>
</html>
