@{
    ViewData["Title"] = "Page not found";
}

<section class="message-page">
    <div class="message-card">
        <span class="message-code">404</span>
        <p class="eyebrow">Page not found</p>
        <h1>That page wandered off.</h1>
        <p>The address may be incorrect, or the page may have moved. The home page is still right where you left it.</p>
        <a class="button button-primary" asp-controller="Home" asp-action="Index">Return home</a>
    </div>
</section>
