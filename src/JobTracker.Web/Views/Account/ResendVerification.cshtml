@model EmailActionViewModel
@{
    ViewData["Title"] = "Resend verification";
}

<section class="account-page">
    <div class="account-card">
        <p class="eyebrow">Email verification</p>
        <h1>Send a fresh code.</h1>
        <p class="account-lead">Enter the email address for your unverified account. Codes expire after 10 minutes.</p>

        <form method="post" class="account-form">
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
            <div class="field">
                <label asp-for="Email"></label>
                <input asp-for="Email" autocomplete="email" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>
            <button class="button button-primary" type="submit">Send verification code</button>
        </form>

        <a class="text-link account-back" asp-action="Login">Back to sign in</a>
    </div>
</section>
