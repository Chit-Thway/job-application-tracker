@model RegisterViewModel
@{
    ViewData["Title"] = "Create account";
    ViewData["Section"] = "register";
}

<section class="account-page">
    <div class="account-card">
        <p class="eyebrow">Open registration</p>
        <h1>Create your account.</h1>
        <p class="account-lead">Create a private Tier 1 workspace, then verify your email with a six-digit code.</p>

        <form method="post" asp-action="Register" class="account-form">
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

            <div class="field">
                <label asp-for="DisplayName"></label>
                <input asp-for="DisplayName" autocomplete="name" />
                <span asp-validation-for="DisplayName" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="Email"></label>
                <input asp-for="Email" autocomplete="email" />
                <small class="field-help">Your verification code and account-security messages are sent here.</small>
                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="Password"></label>
                <input asp-for="Password" autocomplete="new-password" />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>

            <label class="check-field policy-agreement">
                <input asp-for="AcceptPolicies" />
                <span>
                    I agree to the <a asp-controller="Home" asp-action="Terms" target="_blank" rel="noopener">Terms of Service</a>
                    and acknowledge the <a asp-controller="Home" asp-action="Privacy" target="_blank" rel="noopener">Privacy Policy</a>.
                </span>
            </label>
            <span asp-validation-for="AcceptPolicies" class="field-error"></span>

            <button class="button button-primary" type="submit">Create account</button>
        </form>

        <div class="account-links">
            <a asp-action="Login">Already have an account?</a>
        </div>

        <p class="account-note">Tier 1 includes up to 10 stored applications. An administrator can upgrade an account to unlimited Tier 2.</p>
    </div>
</section>
