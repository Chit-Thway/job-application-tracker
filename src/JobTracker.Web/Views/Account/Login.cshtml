@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
    ViewData["Section"] = "login";
}

<section class="account-page">
    <div class="account-card">
        <p class="eyebrow">Private tracker</p>
        <h1>Welcome back.</h1>
        <p class="account-lead">Sign in with your verified Job Application Tracker account.</p>

        @if (Model.EmailVerificationRequired)
        {
            <aside class="verification-required-alert" role="alert" aria-live="assertive">
                <span class="verification-required-icon" aria-hidden="true">!</span>
                <div>
                    <h2>Email verification required</h2>
                    <p>Your password is correct, but you must enter the six-digit code sent to your email before signing in.</p>
                    <form method="post" asp-action="ResendVerification" class="verification-resend-form">
                        <input type="hidden" name="Email" value="@Model.Email" />
                        <button class="button verification-resend-button" type="submit">Send a new verification code</button>
                    </form>
                </div>
            </aside>
        }

        <form method="post" asp-action="Login" class="account-form">
            <input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

            <div class="field">
                <label asp-for="Email"></label>
                <input asp-for="Email" autocomplete="email" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="Password"></label>
                <input asp-for="Password" autocomplete="current-password" />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <label class="check-field">
                <input asp-for="RememberMe" />
                <span>Keep me signed in on this device</span>
            </label>

            <button class="button button-primary" type="submit">Sign in</button>
        </form>

        <div class="account-links">
            <a asp-action="Register">Create an account</a>
            <a asp-action="ForgotPassword">Forgot your password?</a>
            <a asp-action="ResendVerification">Resend verification code</a>
        </div>

        <p class="account-note">Registration is open. New accounts start on Tier 1 with space for 10 applications.</p>
    </div>
</section>
