@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
}

<section class="account-page">
    <div class="account-card">
        <p class="eyebrow">Account recovery</p>
        <h1>Choose a new password.</h1>
        <p class="account-lead">Use at least 12 characters with uppercase, lowercase, a number, and a symbol.</p>

        <form method="post" class="account-form">
            <input asp-for="UserId" type="hidden" />
            <input asp-for="Code" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

            <div class="field">
                <label asp-for="Password">New password</label>
                <input asp-for="Password" autocomplete="new-password" />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="ConfirmPassword">Confirm new password</label>
                <input asp-for="ConfirmPassword" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>

            <button class="button button-primary" type="submit">Change password</button>
        </form>
    </div>
</section>
