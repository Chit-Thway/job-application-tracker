@model EmailActionViewModel
@{
    ViewData["Title"] = "Forgot password";
}

<section class="account-page">
    <div class="account-card">
        <p class="eyebrow">Account recovery</p>
        <h1>Reset your password.</h1>
        <p class="account-lead">Enter your verified email address. The response is intentionally the same whether an account exists or not.</p>

        <form method="post" class="account-form">
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
            <div class="field">
                <label asp-for="Email"></label>
                <input asp-for="Email" autocomplete="email" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>
            <button class="button button-primary" type="submit">Send reset message</button>
        </form>

        <a class="text-link account-back" asp-action="Login">Back to sign in</a>
    </div>
</section>
