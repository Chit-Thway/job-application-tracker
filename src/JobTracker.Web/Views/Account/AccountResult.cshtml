@model AccountResultViewModel
@{
    ViewData["Title"] = Model.Title;
}

<section class="message-page">
    <div class="message-card account-result">
        <span class="result-symbol @(Model.IsSuccess ? "is-success" : "is-warning")" aria-hidden="true">
            @(Model.IsSuccess ? "✓" : "!")
        </span>
        <p class="eyebrow">Account</p>
        <h1>@Model.Title</h1>
        <p>@Model.Message</p>
        <a class="button button-primary" asp-action="Login">Go to sign in</a>
    </div>
</section>
