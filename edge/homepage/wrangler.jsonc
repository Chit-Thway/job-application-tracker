{
  "name": "job-tracker-homepage-preview",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-21",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "PUBLIC_ORIGIN": "https://myjobtracker.com.au"
  },
  "assets": {
    "directory": "../../artifacts/homepage-edge",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/", "/homepage.html", "/landing-video/*"]
  }
}
